{
  "schema_version": 4,
  "governance_lineage": "v4.0-tiered-confirmation",
  "canonical": {
    "repo": "qiaoen12/g-lite",
    "ref": "main",
    "current_bindings": {
      "developer_app": {"id": 5017695, "slug": "g-lite-developer", "actor": "g-lite-developer[bot]"}
    }
  },
  "bootstrap": [
    {"path": "AGENTS.md", "source": "tools/repo-reconciler/templates/minimal-consumer-AGENTS.md"},
    {"path": ".github/ISSUE_TEMPLATE/task.md", "source": ".github/ISSUE_TEMPLATE/task.md"},
    {"path": ".github/pull_request_template.md", "source": ".github/pull_request_template.md"}
  ],
  "protocol": {
    "markers": [
      {"path": "AGENTS.md", "markers": ["常规", "上线", "结果汇报", "改动摘要", "Human Authority", "Developer"]},
      {"path": ".github/ISSUE_TEMPLATE/task.md", "markers": ["## Background"]},
      {"path": ".github/pull_request_template.md", "markers": ["## Result", "## Changes", "## Verification", "## Unverified / Risks"]}
    ]
  },
  "repository_settings": {
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": false
  },
  "security_and_analysis": {
    "secret_scanning": {"status": "enabled"},
    "secret_scanning_push_protection": {"status": "enabled"}
  },
  "ruleset": {
    "name": "G-lite main",
    "legacy_names": ["G-lite main legacy", "G-lite main v3"],
    "required_approvals": 1,
    "dismiss_stale_reviews_on_push": true,
    "require_code_owner_review": false,
    "require_last_push_approval": false,
    "required_review_thread_resolution": false,
    "allowed_merge_methods": ["squash"],
    "block_deletions": true,
    "block_non_fast_forward": true,
    "strict_required_status_checks_policy": true,
    "do_not_enforce_on_create": false,
    "bypass": "none"
  },
  "protocol_sync": {
    "managed_prefix": {
      "path": "AGENTS.md",
      "payload": "tools/repo-reconciler/templates/minimal-consumer-AGENTS.md"
    },
    "owned_exact": [
      {
        "path": ".github/ISSUE_TEMPLATE/task.md",
        "payload": ".github/ISSUE_TEMPLATE/task.md"
      },
      {
        "path": ".github/pull_request_template.md",
        "payload": ".github/pull_request_template.md"
      }
    ]
  },
  "states": ["PASS", "DRIFT", "PLATFORM_BLOCKER", "PERMISSION_BLOCKER", "UNVERIFIED"]
}
