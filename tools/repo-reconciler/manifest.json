{
  "schema_version": 3,
  "baseline": "v3.4-main-continuous-delivery",
  "canonical": {
    "repo": "qiaoen12/g-lite",
    "ref": "main",
    "current_bindings": {
      "developer_app": {"id": 5017695, "slug": "g-lite-developer", "actor": "g-lite-developer[bot]"},
      "reviewer_app": {"id": 5010632, "slug": "g-lite-reviewer", "actor": "g-lite-reviewer[bot]"}
    }
  },
  "bootstrap": [
    {"path": "AGENTS.md", "source": "tools/repo-reconciler/templates/minimal-consumer-AGENTS.md"},
    {"path": ".github/ISSUE_TEMPLATE/task.md", "source": ".github/ISSUE_TEMPLATE/task.md"},
    {"path": ".github/pull_request_template.md", "source": ".github/pull_request_template.md"}
  ],
  "protocol": {
    "markers": [
      {"path": "AGENTS.md", "markers": ["Issue Contract", "approved", "Developer", "Reviewer", "Human Authority", "Genesis", "ACTIVE", "Local Bootstrap", "Squash merge"]},
      {"path": ".github/ISSUE_TEMPLATE/task.md", "markers": ["## Contract", "### Goal", "### Acceptance", "### Out of scope", "### Authorization"]},
      {"path": ".github/pull_request_template.md", "markers": ["## Why", "Issue Contract:", "## What", "## Test", "## Unverified / Risks", "Fixes #"]}
    ]
  },
  "required_label": {"name": "approved", "legacy_names": ["G-lite approved"], "color": "0e8a16", "description": "Independent authorization for the current Issue Contract version"},
  "repository_settings": {
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": false
  },
  "security_and_analysis": {
    "secret_scanning": {"status": "enabled"},
    "secret_scanning_push_protection": {"status": "enabled"}
  },
  "ruleset": {
    "name": "G-lite main",
    "legacy_names": ["G-lite main legacy", "G-lite main v3"],
    "required_approvals": 1,
    "dismiss_stale_reviews_on_push": true,
    "require_code_owner_review": false,
    "require_last_push_approval": false,
    "required_review_thread_resolution": false,
    "allowed_merge_methods": ["squash"],
    "block_deletions": true,
    "block_non_fast_forward": true,
    "strict_required_status_checks_policy": false,
    "do_not_enforce_on_create": false,
    "bypass": "none"
  },
  "protocol_sync": {
    "markers": {
      "start": "<!-- g-lite:managed protocol start -->",
      "end": "<!-- g-lite:managed protocol end -->"
    },
    "managed": [
      {"path": "AGENTS.md", "payload": "tools/repo-reconciler/templates/minimal-consumer-AGENTS.md"},
      {"path": ".github/ISSUE_TEMPLATE/task.md", "payload": "tools/repo-reconciler/templates/consumer-task-protocol.md"},
      {"path": ".github/pull_request_template.md", "payload": "tools/repo-reconciler/templates/consumer-pr-protocol.md"}
    ],
    "legacy": [
      {"path": ".github/ISSUE_TEMPLATE/contract.md", "canonical": ".github/ISSUE_TEMPLATE/task.md"}
    ],
    "owned_exact": []
  },
  "states": ["PASS", "DRIFT", "PLATFORM_BLOCKER", "PERMISSION_BLOCKER", "UNVERIFIED"]
}
